import React, { createContext, useContext, useState, useEffect } from 'react';
import { Seller, Payment, AdminEarning, Repasse, WhatsAppNotification, PaymentMethod, OwnerEscrowConfig } from '../types';
import { INITIAL_SELLERS, INITIAL_PAYMENTS, INITIAL_ADMIN_EARNINGS, INITIAL_REPASSES, INITIAL_ESCROW_CONFIG } from '../lib/constants';
import { supabase, isSupabaseConfigured } from '../lib/supabase';

export type ActivePage = 'landing' | 'register' | 'seller_dashboard' | 'admin_owner' | 'passenger_checkout';

interface AppContextType {
  activePage: ActivePage;
  setActivePage: (page: ActivePage) => void;
  currentSeller: Seller;
  setCurrentSeller: (seller: Seller) => void;
  authenticatedSeller: Seller | null;
  allSellers: Seller[];
  payments: Payment[];
  adminEarnings: AdminEarning[];
  repasses: Repasse[];
  notifications: WhatsAppNotification[];
  currentCheckoutPayment: Partial<Payment> | null;
  setCurrentCheckoutPayment: (p: Partial<Payment> | null) => void;
  // Network / Offline status (Funciona Sem Saldo de Dados)
  isOnline: boolean;
  // Auth state for Owner
  isOwnerAuthenticated: boolean;
  verifyOwnerPin: (pinOrPassword: string) => boolean;
  logoutOwner: () => void;
  // Owner Escrow Account Configuration (onde cai o dinheiro da empresa)
  ownerEscrowConfig: OwnerEscrowConfig;
  updateOwnerEscrowConfig: (config: Partial<OwnerEscrowConfig>) => void;
  // Taxista Auth & Settings Actions
  loginSeller: (phoneOrEmail: string, password: string) => { success: boolean; message?: string };
  logoutSeller: () => void;
  updateSellerSettings: (
    sellerId: string,
    settings: {
      biNumber: string;
      expressPhone: string;
      iban: string;
      bankName: string;
      address?: string;
    }
  ) => void;
  // General Actions
  registerSeller: (data: Omit<Seller, 'id' | 'createdAt'>) => Seller;
  processPayment: (params: {
    sellerId: string;
    amount: number;
    passengerName: string;
    passengerPhone: string;
    paymentMethod: PaymentMethod;
    notes?: string;
  }) => Promise<Payment>;
  dismissNotification: (id: string) => void;
  openCheckoutWithPrice: (sellerId: string, amount: number) => void;
  resetAllDataToDefault: () => void;
  activeNotification: WhatsAppNotification | null;
}

const AppContext = createContext<AppContextType | undefined>(undefined);

export const AppProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [activePage, setActivePage] = useState<ActivePage>('landing');
  
  // Load sellers
  const [allSellers, setAllSellers] = useState<Seller[]>(() => {
    const saved = localStorage.getItem('pagafacil_sellers');
    return saved ? JSON.parse(saved) : INITIAL_SELLERS;
  });

  // Authenticated taxista session
  const [authenticatedSeller, setAuthenticatedSeller] = useState<Seller | null>(() => {
    const saved = localStorage.getItem('pagafacil_auth_seller');
    if (saved) {
      try {
        return JSON.parse(saved);
      } catch (e) {
        return null;
      }
    }
    return null;
  });

  const [currentSeller, setCurrentSeller] = useState<Seller>(() => {
    if (authenticatedSeller) return authenticatedSeller;
    const savedId = localStorage.getItem('pagafacil_current_seller_id');
    const found = allSellers.find((s) => s.id === savedId);
    return found || allSellers[0];
  });

  // Owner Escrow Configuration (Configuração da conta da empresa e Express do Dono)
  const [ownerEscrowConfig, setOwnerEscrowConfig] = useState<OwnerEscrowConfig>(() => {
    const saved = localStorage.getItem('pagafacil_owner_escrow_config');
    return saved ? JSON.parse(saved) : INITIAL_ESCROW_CONFIG;
  });

  const [payments, setPayments] = useState<Payment[]>(() => {
    const saved = localStorage.getItem('pagafacil_payments');
    return saved ? JSON.parse(saved) : INITIAL_PAYMENTS;
  });

  const [adminEarnings, setAdminEarnings] = useState<AdminEarning[]>(() => {
    const saved = localStorage.getItem('pagafacil_admin_earnings');
    return saved ? JSON.parse(saved) : INITIAL_ADMIN_EARNINGS;
  });

  const [repasses, setRepasses] = useState<Repasse[]>(() => {
    const saved = localStorage.getItem('pagafacil_repasses');
    return saved ? JSON.parse(saved) : INITIAL_REPASSES;
  });

  const [notifications, setNotifications] = useState<WhatsAppNotification[]>([]);
  const [activeNotification, setActiveNotification] = useState<WhatsAppNotification | null>(null);
  const [currentCheckoutPayment, setCurrentCheckoutPayment] = useState<Partial<Payment> | null>(null);
  const [isOwnerAuthenticated, setIsOwnerAuthenticated] = useState<boolean>(() => {
    return sessionStorage.getItem('pagafacil_owner_auth') === 'true';
  });

  // Sync to localStorage
  useEffect(() => {
    localStorage.setItem('pagafacil_sellers', JSON.stringify(allSellers));
  }, [allSellers]);

  useEffect(() => {
    if (authenticatedSeller) {
      localStorage.setItem('pagafacil_auth_seller', JSON.stringify(authenticatedSeller));
    } else {
      localStorage.removeItem('pagafacil_auth_seller');
    }
  }, [authenticatedSeller]);

  useEffect(() => {
    localStorage.setItem('pagafacil_current_seller_id', currentSeller.id);
  }, [currentSeller]);

  useEffect(() => {
    localStorage.setItem('pagafacil_owner_escrow_config', JSON.stringify(ownerEscrowConfig));
  }, [ownerEscrowConfig]);

  useEffect(() => {
    localStorage.setItem('pagafacil_payments', JSON.stringify(payments));
  }, [payments]);

  useEffect(() => {
    localStorage.setItem('pagafacil_admin_earnings', JSON.stringify(adminEarnings));
  }, [adminEarnings]);

  useEffect(() => {
    localStorage.setItem('pagafacil_repasses', JSON.stringify(repasses));
  }, [repasses]);

  // Check URL params for checkout link (?pay=...)
  useEffect(() => {
    const urlParams = new URLSearchParams(window.location.search);
    const sellerId = urlParams.get('seller');
    const amount = urlParams.get('amount');
    if (sellerId) {
      const seller = allSellers.find((s) => s.id === sellerId);
      if (seller) {
        setCurrentSeller(seller);
        setCurrentCheckoutPayment({
          sellerId: seller.id,
          sellerName: seller.name,
          route: seller.route,
          vehicleType: seller.vehicleType,
          plateNumber: seller.plateNumber,
          amount: amount ? parseInt(amount, 10) : seller.defaultPrice,
        });
        setActivePage('passenger_checkout');
      }
    }
  }, [allSellers]);

  // Offline network status tracking (Funciona Sem Saldo de Dados)
  const [isOnline, setIsOnline] = useState<boolean>(
    typeof navigator !== 'undefined' ? navigator.onLine : true
  );

  useEffect(() => {
    const handleOnline = () => setIsOnline(true);
    const handleOffline = () => setIsOnline(false);
    window.addEventListener('online', handleOnline);
    window.addEventListener('offline', handleOffline);
    return () => {
      window.removeEventListener('online', handleOnline);
      window.removeEventListener('offline', handleOffline);
    };
  }, []);

  // Owner Authentication (Segurança Máxima Impenetrável - Exclusivo: Zacarias&1)
  const verifyOwnerPin = (pinOrPassword: string): boolean => {
    const clean = pinOrPassword.trim();
    // Palavra-passe mestra ultra secreta e única do Dono: Zacarias&1
    if (clean === 'Zacarias&1') {
      setIsOwnerAuthenticated(true);
      sessionStorage.setItem('pagafacil_owner_auth', 'true');
      return true;
    }
    return false;
  };

  const logoutOwner = () => {
    setIsOwnerAuthenticated(false);
    sessionStorage.removeItem('pagafacil_owner_auth');
    setActivePage('landing');
  };

  // Taxista Login
  const loginSeller = (phoneOrEmail: string, password: string): { success: boolean; message?: string } => {
    const cleanQuery = phoneOrEmail.trim().toLowerCase();
    const cleanPass = password.trim();

    const matched = allSellers.find((s) => {
      const matchPhone = s.phone.trim() === cleanQuery;
      const matchEmail = s.email.trim().toLowerCase() === cleanQuery;
      return matchPhone || matchEmail;
    });

    if (!matched) {
      return { success: false, message: 'Telefone ou email não encontrado no sistema.' };
    }

    if (matched.password && matched.password !== cleanPass) {
      return { success: false, message: 'Palavra-passe secreta incorreta.' };
    }

    setAuthenticatedSeller(matched);
    setCurrentSeller(matched);
    return { success: true };
  };

  const logoutSeller = () => {
    setAuthenticatedSeller(null);
  };

  // Taxista Configuration Update (BI, Express, IBAN, Banco, Morada)
  const updateSellerSettings = (
    sellerId: string,
    settings: {
      biNumber: string;
      expressPhone: string;
      iban: string;
      bankName: string;
      address?: string;
    }
  ) => {
    setAllSellers((prev) =>
      prev.map((s) => {
        if (s.id === sellerId) {
          const updated = {
            ...s,
            biNumber: settings.biNumber,
            expressPhone: settings.expressPhone,
            iban: settings.iban,
            nib: settings.iban,
            bankName: settings.bankName,
            address: settings.address || s.address
          };
          if (authenticatedSeller?.id === sellerId) {
            setAuthenticatedSeller(updated);
          }
          if (currentSeller?.id === sellerId) {
            setCurrentSeller(updated);
          }
          return updated;
        }
        return s;
      })
    );
  };

  // Owner Escrow Config Update
  const updateOwnerEscrowConfig = (config: Partial<OwnerEscrowConfig>) => {
    setOwnerEscrowConfig((prev) => ({
      ...prev,
      ...config,
      lastUpdated: new Date().toISOString()
    }));
  };

  const registerSeller = (data: Omit<Seller, 'id' | 'createdAt'>): Seller => {
    const newSeller: Seller = {
      ...data,
      id: `taxista-${Date.now().toString(36)}`,
      createdAt: new Date().toISOString()
    };

    setAllSellers((prev) => [newSeller, ...prev]);
    setCurrentSeller(newSeller);
    setAuthenticatedSeller(newSeller);
    return newSeller;
  };

  const processPayment = async ({
    sellerId,
    amount,
    passengerName,
    passengerPhone,
    paymentMethod,
    notes
  }: {
    sellerId: string;
    amount: number;
    passengerName: string;
    passengerPhone: string;
    paymentMethod: PaymentMethod;
    notes?: string;
  }): Promise<Payment> => {
    const seller = allSellers.find((s) => s.id === sellerId) || currentSeller;
    const splitRate = ownerEscrowConfig.splitPercentage || 0.0333;
    const feeAmount = Math.round(amount * splitRate);
    const netAmount = amount - feeAmount;

    const randomSuffix = Math.random().toString(36).substring(2, 6).toUpperCase();
    const txId = `GPO-${Date.now().toString().slice(-6)}-${randomSuffix}`;
    const timestamp = new Date().toISOString();
    const signatureSha256 = btoa(`${txId}-${amount}-${seller.plateNumber}-${Date.now()}`).substring(0, 24);
    const qrPayload = `PAGA-FACIL-AO|${txId}|${seller.plateNumber}|${amount}KZ|SPLIT-BAI`;

    const newPayment: Payment = {
      id: `pay-${Date.now()}`,
      txId,
      sellerId: seller.id,
      sellerName: seller.name,
      sellerPhone: seller.phone,
      sellerNib: seller.nib,
      route: seller.route,
      vehicleType: seller.vehicleType,
      plateNumber: seller.plateNumber,
      amount,
      feeAmount,
      netAmount,
      passengerName: passengerName || 'Passageiro Luanda',
      passengerPhone: passengerPhone || '924000000',
      paymentMethod,
      status: 'pago',
      timestamp,
      signatureSha256,
      qrPayload,
      notes: notes || `Validado por EMIS GPO via Escrow ${ownerEscrowConfig.bankName}`
    };

    const newAdminEarning: AdminEarning = {
      id: `adm-${newPayment.id}`,
      paymentId: newPayment.id,
      txId,
      sellerId: seller.id,
      amount: feeAmount,
      grossPayment: amount,
      escrowAccount: `${ownerEscrowConfig.bankName} - ${ownerEscrowConfig.accountNumber} (${ownerEscrowConfig.companyName})`,
      status: 'consolidado',
      timestamp
    };

    const newRepasse: Repasse = {
      id: `rep-${newPayment.id}`,
      paymentId: newPayment.id,
      txId,
      sellerId: seller.id,
      sellerName: seller.name,
      sellerPhone: seller.expressPhone || seller.phone,
      sellerNib: seller.iban || seller.nib,
      amount: netAmount,
      splitTimeSeconds: 3,
      status: 'liquidado_automatico',
      bankRef: `SPLIT-${txId}`,
      timestamp
    };

    // Update in-memory & LocalStorage
    setPayments((prev) => [newPayment, ...prev]);
    setAdminEarnings((prev) => [newAdminEarning, ...prev]);
    setRepasses((prev) => [newRepasse, ...prev]);

    // Dispatch WhatsApp Notification to Taxista
    const notif: WhatsAppNotification = {
      id: `wa-${Date.now()}`,
      recipientPhone: seller.expressPhone || seller.phone,
      recipientName: seller.name,
      amount: netAmount,
      txId,
      senderName: passengerName,
      route: seller.route,
      timestamp: new Date().toLocaleTimeString('pt-AO', { hour: '2-digit', minute: '2-digit', second: '2-digit' }),
      status: 'delivered'
    };

    setNotifications((prev) => [notif, ...prev]);
    setActiveNotification(notif);

    // If Supabase is connected, asynchronously insert into real Supabase tables
    if (isSupabaseConfigured && supabase) {
      try {
        await supabase.from('payments').insert([{
          id: newPayment.id,
          tx_id: newPayment.txId,
          seller_id: newPayment.sellerId,
          seller_name: newPayment.sellerName,
          seller_phone: newPayment.sellerPhone,
          seller_nib: newPayment.sellerNib,
          route: newPayment.route,
          vehicle_type: newPayment.vehicleType,
          plate_number: newPayment.plateNumber,
          amount: newPayment.amount,
          fee_amount: newPayment.feeAmount,
          net_amount: newPayment.netAmount,
          passenger_name: newPayment.passengerName,
          passenger_phone: newPayment.passengerPhone,
          payment_method: newPayment.paymentMethod,
          status: newPayment.status,
          signature_sha256: newPayment.signatureSha256,
          qr_payload: newPayment.qrPayload,
          notes: newPayment.notes
        }]);

        await supabase.from('admin_earnings').insert([{
          id: newAdminEarning.id,
          payment_id: newAdminEarning.paymentId,
          tx_id: newAdminEarning.txId,
          seller_id: newAdminEarning.sellerId,
          amount: newAdminEarning.amount,
          gross_payment: newAdminEarning.grossPayment,
          escrow_account: newAdminEarning.escrowAccount,
          status: newAdminEarning.status
        }]);

        await supabase.from('repasses').insert([{
          id: newRepasse.id,
          payment_id: newRepasse.paymentId,
          tx_id: newRepasse.txId,
          seller_id: newRepasse.sellerId,
          seller_name: newRepasse.sellerName,
          seller_phone: newRepasse.sellerPhone,
          seller_nib: newRepasse.sellerNib,
          amount: newRepasse.amount,
          split_time_seconds: newRepasse.splitTimeSeconds,
          status: newRepasse.status,
          bank_ref: newRepasse.bankRef
        }]);
      } catch (err) {
        console.warn('Supabase sync skipped/error:', err);
      }
    }

    return newPayment;
  };

  const dismissNotification = (id: string) => {
    setActiveNotification(null);
    setNotifications((prev) => prev.filter((n) => n.id !== id));
  };

  const openCheckoutWithPrice = (sellerId: string, amount: number) => {
    const s = allSellers.find((item) => item.id === sellerId) || currentSeller;
    setCurrentSeller(s);
    setCurrentCheckoutPayment({
      sellerId: s.id,
      sellerName: s.name,
      route: s.route,
      vehicleType: s.vehicleType,
      plateNumber: s.plateNumber,
      amount
    });
    setActivePage('passenger_checkout');
  };

  const resetAllDataToDefault = () => {
    setAllSellers(INITIAL_SELLERS);
    setCurrentSeller(INITIAL_SELLERS[0]);
    setAuthenticatedSeller(null);
    setOwnerEscrowConfig(INITIAL_ESCROW_CONFIG);
    setPayments(INITIAL_PAYMENTS);
    setAdminEarnings(INITIAL_ADMIN_EARNINGS);
    setRepasses(INITIAL_REPASSES);
    setNotifications([]);
    setActiveNotification(null);
    localStorage.removeItem('pagafacil_sellers');
    localStorage.removeItem('pagafacil_auth_seller');
    localStorage.removeItem('pagafacil_current_seller_id');
    localStorage.removeItem('pagafacil_owner_escrow_config');
    localStorage.removeItem('pagafacil_payments');
    localStorage.removeItem('pagafacil_admin_earnings');
    localStorage.removeItem('pagafacil_repasses');
  };

  return (
    <AppContext.Provider
      value={{
        activePage,
        setActivePage,
        currentSeller,
        setCurrentSeller,
        authenticatedSeller,
        allSellers,
        payments,
        adminEarnings,
        repasses,
        notifications,
        activeNotification,
        currentCheckoutPayment,
        setCurrentCheckoutPayment,
        isOnline,
        isOwnerAuthenticated,
        verifyOwnerPin,
        logoutOwner,
        ownerEscrowConfig,
        updateOwnerEscrowConfig,
        loginSeller,
        logoutSeller,
        updateSellerSettings,
        registerSeller,
        processPayment,
        dismissNotification,
        openCheckoutWithPrice,
        resetAllDataToDefault
      }}
    >
      {children}
    </AppContext.Provider>
  );
};

export const useApp = () => {
  const context = useContext(AppContext);
  if (!context) {
    throw new Error('useApp must be used within an AppProvider');
  }
  return context;
};



