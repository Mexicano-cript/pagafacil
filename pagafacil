import React, { useState } from 'react';
import confetti from 'canvas-confetti';
import { useApp } from '../context/AppContext';
import { PaymentMethod, Payment } from '../types';
import { 
  ShieldCheck, 
  Smartphone, 
  CheckCircle2, 
  ArrowRight, 
  Share2, 
  Printer, 
  Sparkles,
  Car,
  Store,
  ShoppingBag,
  CreditCard,
  Lock,
  ChevronLeft
} from 'lucide-react';

export const PassengerCheckoutPage: React.FC = () => {
  const { currentSeller, currentCheckoutPayment, processPayment, setActivePage, ownerEscrowConfig } = useApp();

  const seller = currentSeller;
  const initialAmount = currentCheckoutPayment?.amount || seller.defaultPrice || 300;

  const [seats, setSeats] = useState<number>(1);
  const [passengerName, setPassengerName] = useState('Mariana Kiala');
  const [passengerPhone, setPassengerPhone] = useState('924881122');
  const [paymentMethod, setPaymentMethod] = useState<PaymentMethod>('MULTICAIXA_EXPRESS');
  const [isProcessing, setIsProcessing] = useState(false);
  const [splitStep, setSplitStep] = useState<number>(0);
  const [completedPayment, setCompletedPayment] = useState<Payment | null>(null);

  const totalAmount = initialAmount * seats;
  const splitRate = ownerEscrowConfig.splitPercentage || 0.0333;
  const feeAmount = Math.round(totalAmount * splitRate);
  const netAmount = totalAmount - feeAmount;

  const handlePay = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsProcessing(true);
    setSplitStep(1); // 00:01s Passageiro paga

    setTimeout(() => {
      setSplitStep(2); // 00:02s EMIS confirma na conta Escrow BAI
    }, 700);

    setTimeout(async () => {
      setSplitStep(3); // 00:03s Split automático

      const payment = await processPayment({
        sellerId: seller.id,
        amount: totalAmount,
        passengerName,
        passengerPhone,
        paymentMethod,
        notes: `Corrida ${seller.route} (${seats} ${seats === 1 ? 'lugar' : 'lugares'})`
      });

      setCompletedPayment(payment);
      setIsProcessing(false);

      // Trigger celebration confetti
      try {
        confetti({
          particleCount: 80,
          spread: 70,
          origin: { y: 0.6 }
        });
      } catch (err) {
        // Safe fallback
      }
    }, 1500);
  };

  return (
    <div className="min-h-screen bg-neutral-950 text-white py-8 px-4 sm:px-6">
      <div className="max-w-xl mx-auto">
        {/* Back Link */}
        <button
          onClick={() => setActivePage('seller_dashboard')}
          className="text-xs text-neutral-400 hover:text-white flex items-center gap-1 mb-4 focus:outline-hidden"
        >
          <ChevronLeft className="w-4 h-4" />
          <span>Voltar ao Painel</span>
        </button>

        {/* If payment completed: Show official digital receipt */}
        {completedPayment ? (
          <div className="bg-neutral-900 border-2 border-emerald-500/50 rounded-3xl p-6 sm:p-8 shadow-2xl text-center space-y-5 animate-in zoom-in-95 duration-300">
            <div className="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto border border-emerald-500/30">
              <CheckCircle2 className="w-10 h-10" />
            </div>

            <div>
              <span className="text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-bold bg-emerald-950 border border-emerald-800 px-2.5 py-1 rounded">
                PAGAMENTO CONCLUÍDO COM SUCESSO
              </span>
              <h1 className="text-2xl font-black text-white mt-2">Recibo Digital Oficial</h1>
              <p className="text-xs text-neutral-400 font-mono mt-0.5">
                ID Transação: <strong className="text-amber-400">{completedPayment.txId}</strong>
              </p>
            </div>

            {/* Split por segundo notification card */}
            <div className="bg-neutral-950 border border-neutral-800 rounded-2xl p-4 text-left space-y-2 text-xs">
              <div className="flex items-center justify-between pb-2 border-b border-neutral-800 text-neutral-400">
                <span>Viatura / Condutor:</span>
                <span className="font-bold text-white">{completedPayment.sellerName} ({completedPayment.plateNumber})</span>
              </div>
              <div className="flex items-center justify-between pb-2 border-b border-neutral-800 text-neutral-400">
                <span>Rota:</span>
                <span className="text-white">{completedPayment.route}</span>
              </div>
              <div className="flex items-center justify-between pb-2 border-b border-neutral-800 text-neutral-400">
                <span>Passageiro:</span>
                <span className="text-white">{completedPayment.passengerName}</span>
              </div>
              <div className="flex items-center justify-between pb-2 border-b border-neutral-800 text-neutral-400">
                <span>Método de Pagamento:</span>
