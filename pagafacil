                </label>
                <div className="relative">
                  <input
                    type="text"
                    required
                    maxLength={6}
                    placeholder="Ex: 849201"
                    value={otpInput}
                    onChange={(e) => {
                      setOtpInput(e.target.value.replace(/\D/g, ''));
                      setOtpError('');
                    }}
                    className="w-full text-center text-3xl font-mono font-black tracking-widest bg-neutral-950 border-2 border-yellow-400 rounded-2xl py-4 px-4 text-yellow-400 focus:outline-hidden"
                  />
                  <KeyRound className="w-5 h-5 text-yellow-400 absolute left-4 top-1/2 -translate-y-1/2 opacity-40" />
