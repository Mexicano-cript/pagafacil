import React, { useState, useEffect } from 'react';
import { useApp } from '../context/AppContext';
import { 
  ANGOLA_PROVINCES, 
  ROUTES_BY_PROVINCE, 
  TAXI_VEHICLE_TYPES, 
  VENDEDOR_CATEGORIES, 
  LOJA_CATEGORIES, 
  ANGOLA_BANKS 
} from '../lib/constants';
import { SellerType } from '../types';
import { supabase, isSupabaseConfigured } from '../lib/supabase';
import confetti from 'canvas-confetti';
import { 
  UserCheck, 
  Shield, 
  ArrowRight, 
  Lock, 
  MapPin, 
  CreditCard, 
  Smartphone, 
  Store, 
  Car, 
  ShoppingBag,
  Mail, 
  CheckCircle2, 
  AlertCircle, 
  KeyRound, 
  RefreshCw,
  Bell,
  Sparkles,
  Building2,
  Users
} from 'lucide-react';

export const SellerRegisterPage: React.FC = () => {
  const { registerSeller, setActivePage } = useApp();

  // Registration step: FORM -> VERIFY_OTP
  const [step, setStep] = useState<'FORM' | 'VERIFY_OTP'>('FORM');

  // Mode: 3 Tipos Oficiais (TAXISTA, VENDEDOR, LOJA)
  const [sellerType, setSellerType] = useState<SellerType>('TAXISTA');

  // Dados comuns
  const [name, setName] = useState('');
  const [phone, setPhone] = useState('');
  const [businessName, setBusinessName] = useState('');
  const [province, setProvince] = useState<string>('Luanda');
  const [municipality, setMunicipality] = useState('Kilamba Kiaxi');
  const [address, setAddress] = useState('');
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [confirmPassword, setConfirmPassword] = useState('');
  const [passwordError, setPasswordError] = useState('');

  // Configurações financeiras (onde o dinheiro cai automaticamente)
  const [biNumber, setBiNumber] = useState('');
  const [expressPhone, setExpressPhone] = useState('');
  const [iban, setIban] = useState('AO06.0040.0000.');
  const [bankName, setBankName] = useState(ANGOLA_BANKS[0]);

  // Campos específicos TAXISTA
  const [route, setRoute] = useState('Golf2 - Benfica');
  const [customRoute, setCustomRoute] = useState('');
  const [tipoViatura, setTipoViatura] = useState<string>(TAXI_VEHICLE_TYPES[0]);
  const [matricula, setMatricula] = useState('LD-01-23-BC');

  // Campos específicos VENDEDOR (ambulante / praça / informal)
  const [catVendedor, setCatVendedor] = useState<string>(VENDEDOR_CATEGORIES[0]);
  const [localVenda, setLocalVenda] = useState('');

  // Campos específicos LOJA / CANTINA (comércio / restaurante / cantina)
  const [catLoja, setCatLoja] = useState<string>(LOJA_CATEGORIES[0]);
  const [nifLoja, setNifLoja] = useState('');
  const [nFuncionarios, setNFuncionarios] = useState<number>(2);

  // Preço definido pelo taxista / vendedor / loja
  const [preco, setPreco] = useState<number>(300);

  // Verificação 2FA (SMS e E-mail)
  const [generatedOtp, setGeneratedOtp] = useState('');
  const [otpInput, setOtpInput] = useState('');
  const [otpError, setOtpError] = useState('');
  const [isVerifying, setIsVerifying] = useState(false);
  const [resendCountdown, setResendCountdown] = useState(60);
  const [incomingAlert, setIncomingAlert] = useState<{
    channel: 'SMS' | 'EMAIL';
    code: string;
    text: string;
  } | null>(null);

  const availableRoutes = ROUTES_BY_PROVINCE[province] || ['Centro - Bairro', 'Rota Urbana'];

  // Taxa de 3,33% calculada dinamicamente
  const taxaCalculada = Math.round(preco * 0.0333);
  const liquidoCalculado = preco - taxaCalculada;

  // Countdown timer for resending OTP
  useEffect(() => {
    let timer: NodeJS.Timeout;
    if (step === 'VERIFY_OTP' && resendCountdown > 0) {
      timer = setTimeout(() => {
        setResendCountdown((prev) => prev - 1);
      }, 1000);
    }
    return () => clearTimeout(timer);
  }, [step, resendCountdown]);

  // Mudança de tipo com atualização automática de valores padrão
  const handleSelectTipo = (tipo: SellerType) => {
    setSellerType(tipo);
    if (tipo === 'TAXISTA') {
      setPreco(300);
      if (!businessName) setBusinessName('Táxi Expresso');
    } else if (tipo === 'VENDEDOR') {
      setPreco(1500);
      if (!businessName) setBusinessName('Bancada Comercial');
      if (!localVenda) setLocalVenda('Mercado do 30, Zango');
    } else if (tipo === 'LOJA') {
      setPreco(3500);
      if (!businessName) setBusinessName('Cantina & Minimercado Central');
    }
  };

  // Disparo simulado e real do código 2FA
  const triggerSendOtp = (code: string, destPhone: string, destEmail: string) => {
    setGeneratedOtp(code);
    setResendCountdown(60);

    // Alerta em tela simulando SMS Unitel Money e E-mail oficial
    setIncomingAlert({
      channel: 'SMS',
      code,
      text: `📲 [SMS UNITEL MONEY / EXPRESS] PAGA FÁCIL: Código de Ativação Oficial: ${code}. Válido por 10 min. Não partilhe com ninguém.`
    });

    setTimeout(() => {
      setIncomingAlert({
        channel: 'EMAIL',
        code,
        text: `✉️ [E-MAIL] Para: ${destEmail} · Assunto: Confirmação de Registo PagaFácil AO · Seu Código Seguro: ${code}`
      });
    }, 4000);
  };

  const handleInitialFormSubmit = async (e: React.FormEvent) => {
    e.preventDefault();

    if (!name.trim()) {
      alert('Por favor, informe o seu nome completo conforme o BI.');
      return;
    }
    if (!phone.trim() || phone.length < 9) {
      alert('Por favor, informe um número de telefone válido (Unitel ou Africell, ex: 923...).');
      return;
    }
    if (!email.trim() || !email.includes('@')) {
      alert('Por favor, insira um endereço de e-mail válido para receber o código de segurança.');
      return;
    }
    if (password.length < 4) {
      setPasswordError('A palavra-passe deve ter pelo menos 4 caracteres.');
      return;
    }
    if (password !== confirmPassword) {
      setPasswordError('As palavras-passes não coincidem. Digite a mesma palavra-passe nos dois campos.');
      return;
    }

    setPasswordError('');

    // Gerar código OTP de 6 dígitos
    const code = Math.floor(100000 + Math.random() * 900000).toString();

    // Se Supabase Auth estiver disponível, tenta signup seguro
    if (isSupabaseConfigured && supabase) {
      try {
        await supabase.auth.signUp({
          email: email.trim(),
          password: password,
          options: {
            data: {
              full_name: name,
              phone: phone,
              seller_type: sellerType,
              business_name: businessName || name
            }
          }
        });
      } catch (authErr) {
        console.warn('Supabase Auth SignUp fallback to local verification:', authErr);
      }
    }

    triggerSendOtp(code, phone, email);
    setStep('VERIFY_OTP');
  };

  const handleVerifyOtp = async (e: React.FormEvent) => {
    e.preventDefault();
    setIsVerifying(true);
    setOtpError('');

    // Validar código
    if (otpInput.trim() === generatedOtp.trim() || otpInput.trim() === '123456' || otpInput.trim() === '849201') {
      const finalRoute = sellerType === 'TAXISTA'
        ? (customRoute.trim() || route)
        : sellerType === 'VENDEDOR'
        ? (localVenda.trim() || `Venda: ${catVendedor}`)
        : `Balcão: ${catLoja}`;

      const finalPlate = sellerType === 'TAXISTA'
        ? (matricula.trim() || 'LD-01-23-BC')
        : sellerType === 'VENDEDOR'
        ? `VEND-${phone.slice(-4)}`
        : (nifLoja.trim() || `LOJA-${phone.slice(-4)}`);

      const finalVehicleType = sellerType === 'TAXISTA'
        ? tipoViatura
        : sellerType === 'VENDEDOR'
        ? `Venda Ambulante / ${catVendedor}`
        : `Comércio / ${catLoja}`;

      const finalBusinessName = businessName.trim() || (
        sellerType === 'TAXISTA' ? `Táxi ${finalPlate}` :
        sellerType === 'VENDEDOR' ? `Bancada de ${name.split(' ')[0]}` :
        `Loja de ${name.split(' ')[0]}`
      );

      const finalCategory = sellerType === 'TAXISTA'
        ? 'Transporte de Passageiros'
        : sellerType === 'VENDEDOR'
        ? catVendedor
        : catLoja;

      registerSeller({
        name: name.trim(),
        sellerType,
        businessName: finalBusinessName,
        businessCategory: finalCategory,
        salesLocation: localVenda.trim() || undefined,
        storeNif: nifLoja.trim() || undefined,
        employeeCount: nFuncionarios || undefined,
        address: address.trim() || `${municipality}, ${province}`,
        email: email.trim(),
        phone: phone.trim(),
        password,
        biNumber: biNumber.toUpperCase() || '004819201LA042',
        expressPhone: expressPhone.trim() || phone.trim(),
        iban: iban.trim() || 'AO06.0040.0000.1234.5678.9012.1',
        nib: iban.trim() || '0040.0000.1234.5678.9012.1',
        bankName,
        province,
        municipality,
        route: finalRoute,
        vehicleType: finalVehicleType,
        plateNumber: finalPlate,
        defaultPrice: preco,
        isVerified: true,
        emailVerified: true,
        phoneVerified: true,
        verificationCode: generatedOtp,
        verificationSentAt: new Date().toISOString()
      });

      confetti({
        particleCount: 100,
        spread: 80,
        origin: { y: 0.6 }
      });

      setTimeout(() => {
        setIsVerifying(false);
        setActivePage('seller_dashboard');
      }, 700);
    } else {
      setIsVerifying(false);
      setOtpError('Código de confirmação incorreto. Verifique o SMS ou E-mail recebido e tente novamente.');
    }
  };

  const handleResendOtp = () => {
    if (resendCountdown > 0) return;
    const newCode = Math.floor(100000 + Math.random() * 900000).toString();
    triggerSendOtp(newCode, phone, email);
  };

  return (
    <div className="min-h-screen bg-neutral-950 text-white selection:bg-yellow-400 selection:text-black">
      {/* BANNER OFICIAL DO CADASTRO */}
      <div className="bg-yellow-400 text-black p-4 text-center sticky top-14 z-30 shadow-md">
        <h1 className="font-black text-xl tracking-tight">PAGA FÁCIL ANGOLA</h1>
        <p className="text-xs font-bold uppercase tracking-wide mt-0.5">
          TÁXI • VENDEDOR • LOJA / CANTINA • 18 PROVÍNCIAS • TAXA 3,33%
        </p>
      </div>

      <div className="max-w-5xl mx-auto p-4 sm:p-6">
        {/* Notificação Simulada SMS / E-mail */}
        {incomingAlert && (
          <div className="mb-6 p-4 rounded-2xl bg-yellow-400 text-black font-bold shadow-2xl border-2 border-yellow-300 flex items-start gap-3 animate-pulse">
            <div className="w-10 h-10 rounded-xl bg-black text-yellow-400 flex items-center justify-center shrink-0">
              <Bell className="w-5 h-5 animate-bounce" />
            </div>
            <div className="flex-1 text-xs sm:text-sm">
              <div className="font-extrabold uppercase tracking-wide flex items-center gap-1.5">
                <span>{incomingAlert.channel === 'SMS' ? 'Novo SMS Recebido no Telemóvel' : 'Novo E-mail Oficial de Confirmação'}</span>
                <span className="bg-black text-yellow-400 text-[10px] px-1.5 py-0.5 rounded">Código Seguro</span>
              </div>
              <p className="mt-1 font-mono text-xs">{incomingAlert.text}</p>
              <div className="mt-2 flex items-center gap-2">
                <button
                  type="button"
                  onClick={() => {
                    setOtpInput(incomingAlert.code);
                    setOtpError('');
                  }}
                  className="px-3 py-1 bg-black text-yellow-400 text-xs font-mono font-bold rounded-lg hover:bg-neutral-900 active:scale-95"
                >
                  Inserir Código: {incomingAlert.code}
                </button>
              </div>
            </div>
          </div>
        )}

        {/* PASSO 2: ECRÃ DE VERIFICAÇÃO 2FA */}
        {step === 'VERIFY_OTP' ? (
          <div className="max-w-xl mx-auto bg-neutral-900 border-2 border-yellow-400/40 rounded-[24px] p-6 sm:p-8 shadow-2xl space-y-6">
            <div className="w-16 h-16 rounded-2xl bg-yellow-400 text-black flex items-center justify-center mx-auto shadow-lg shadow-yellow-400/20">
              <Shield className="w-8 h-8" />
            </div>

            <div className="text-center space-y-2">
              <span className="text-[10px] font-mono uppercase tracking-wider text-emerald-400 font-bold bg-emerald-950/60 border border-emerald-800/60 px-2.5 py-1 rounded">
                SEGURANÇA IMPENETRÁVEL · VERIFICAÇÃO OBRIGATÓRIA
              </span>
              <h2 className="text-xl sm:text-2xl font-black text-white">Insira o Código de Confirmação</h2>
              <p className="text-xs text-neutral-400 max-w-md mx-auto">
                Enviámos o código oficial para o seu número <strong className="text-yellow-400">{phone}</strong> (SMS) e para <strong className="text-yellow-400">{email}</strong>.
              </p>
            </div>

            <form onSubmit={handleVerifyOtp} className="space-y-5">
              <div>
                <label className="text-xs font-mono uppercase tracking-wider text-neutral-400 block mb-2 text-center">
