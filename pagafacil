                className={`w-full py-4 px-6 rounded-2xl font-black text-sm uppercase tracking-wide transition-all shadow-lg flex items-center justify-center gap-2 ${
                  isVerifying || otpInput.length < 4
                    ? 'bg-neutral-800 text-neutral-500 cursor-not-allowed'
                    : 'bg-yellow-400 hover:bg-yellow-300 text-black active:scale-98 shadow-yellow-400/20'
